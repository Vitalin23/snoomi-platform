# =========================
# Core AI settings
# =========================
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_ART_KEY=
HUGGINGFACE_TOKEN=

# =========================
# Telegram bot settings
# =========================
TELEGRAM_BOT_TOKEN=
TG_ADMIN=

# Channel publishing (legacy/global fallback)
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_TOKEN=

# =========================
# VK publishing settings
# =========================
VK_ACCESS_TOKEN=
VK_GROUP_ID=

# =========================
# System toggles
# =========================
PUBLISH_TO_VK=True
PUBLISH_TO_TG=True
PUBLISH_HOUR=10

# =========================
# Web app settings
# =========================
ENABLE_MONETIZATION_ADMIN_PANEL=False
ENABLE_EXPERT_AGENT=1
WEB_HOST=127.0.0.1
WEB_PORT=5000
# Optional, for custom local DB path:
# WEB_DATABASE_URL=sqlite:////absolute/path/to/snoomi_channels.db

# Public URL for links in registration emails
PUBLIC_BASE_URL=http://localhost:5000

# =========================
# SMTP for registration emails
# =========================
# Delivery mode:
# - auto: uses SMTP when SMTP_HOST is set, otherwise writes .eml files to logs/dev_outbox
# - smtp: force SMTP sending (fails if SMTP_HOST is empty)
# - stub: always write .eml files to local outbox
EMAIL_DELIVERY_MODE=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Snoomi Platform
SMTP_USE_SSL=False
SMTP_USE_TLS=True

# =========================
# Optional help links in UI
# =========================
SPECIALIST_TELEGRAM_LINK=
SERVICE_TELEGRAM_BOT_USERNAME=
TELEGRAM_TOKEN_HELP_URL=https://core.telegram.org/bots/tutorial
VK_TOKEN_HELP_URL=https://vk.com/dev/access_token
